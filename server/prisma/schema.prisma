// PostgreSQL everywhere — Railway-managed in production, and (per
// server/DEPLOY notes) a real Postgres for local dev/tests too, now that
// the schema has committed to this provider. See prisma/migrations/ for
// history; `prisma migrate deploy` applies it on every boot (server start
// script), so this is safe to redeploy repeatedly.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  chipBalance Int      @default(1000)
  createdAt   DateTime @default(now())

  /// Consecutive UTC calendar days with at least one hand played, most recent streak.
  currentStreak Int @default(0)
  /// Highest currentStreak this user has ever reached — never decreases.
  longestStreak Int @default(0)
  /// UTC-midnight-normalized date of the last hand this user played — the
  /// only state needed to tell "continues the streak" (exactly 1 day later)
  /// from "streak broke" (anything more) on their next hand. Null before
  /// their first ever recorded hand.
  lastPlayedDate DateTime?
  /// UTC-midnight-normalized date the daily-mission chip reward was last
  /// claimed — guards against claiming twice in the same day. Null until
  /// the first ever claim.
  dailyMissionClaimedDate DateTime?

  handAppearances HandHistoryPlayer[]
}

// Deliberately has no relation to User: a code can be requested for an email
// that doesn't have an account yet (first-time sign-up creates it on verify).
model OneTimeCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

model TableRecord {
  id        String   @id @default(uuid())
  code      String
  stakeType String
  ante      Int
  createdAt DateTime @default(now())

  hands HandHistoryRecord[]
}

model HandHistoryRecord {
  id           String   @id @default(uuid())
  table        TableRecord @relation(fields: [tableId], references: [id])
  tableId      String
  reason       String
  /// Null only for "stock-exhausted" ("se va doble") — the deck ran out with nobody winning that hand.
  winnerUserId String?
  playedAt     DateTime @default(now())

  players HandHistoryPlayer[]
}

model HandHistoryPlayer {
  id         String  @id @default(uuid())
  hand       HandHistoryRecord @relation(fields: [handId], references: [id])
  handId     String
  user       User    @relation(fields: [userId], references: [id])
  userId     String
  seatIndex  Int
  isWinner   Boolean
  chipsDelta Int     @default(0)
  /// Only nonzero on the winner's row: how much of chipsDelta came from Mico/Patona bonuses (vs. just the ante pot).
  bonusChipsCollected Int @default(0)
}
